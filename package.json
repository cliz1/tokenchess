{
  "name": "tokenchess",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "npm run content:check && npm run content:verify && npm run test:engine",
    "content:build": "node tools/content/build.mjs",
    "content:check": "node tools/content/build.mjs --check",
    "content:verify": "node tools/content/verify.mjs",
    "puzzles": "node tools/content/status.mjs",
    "test:engine": "node tools/engine-parity/parity.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@badrap/result": "^0.2.13",
    "chessground": "github:cliz1/chessground#931e04aab850549d025ab4eb65b6ea35905ee8bb",
    "chessops": "github:cliz1/chessops#6bf2e9b5bededc5347b55fe29c0eabbf904eef22",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.8.2",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.2.2"
  }
}
